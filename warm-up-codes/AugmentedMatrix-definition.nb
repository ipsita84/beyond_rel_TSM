Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"matA", "=", 
   RowBox[{"Array", "[", 
    RowBox[{"a", ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"amat", "=", 
    RowBox[{"AugmentedMatrix", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"matA", ".", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "\[Equal]", 
         RowBox[{
          SubscriptBox["\[Lambda]", "1"], " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}]}], ",", 
        RowBox[{
         RowBox[{"matA", ".", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{"-", "3"}]}], "}"}]}], "==", 
         RowBox[{
          SubscriptBox["\[Lambda]", "2"], " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{"-", "3"}]}], "}"}]}]}]}], "}"}], ",", 
      RowBox[{"Flatten", "[", "matA", "]"}]}], "]"}]}], ")"}], "//", 
  "MatrixForm"}]}], "Input",
