Cell[BoxData[{
 RowBox[{
  RowBox[{"AugmentedMatrix", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "vars_"}], "]"}], ":=", 
  RowBox[{"{", "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AugmentedMatrix", "[", 
   RowBox[{
    RowBox[{"matA_List", "\[Equal]", "matB_List"}], ",", "vars_"}], "]"}], ":=", 
  RowBox[{"AugmentedMatrix", "[", 
   RowBox[{
    RowBox[{"matA", "-", "matB"}], ",", "vars"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AugmentedMatrix", "[", 
   RowBox[{"mat_", ",", "vars_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"temp", "=", 
      RowBox[{"CoefficientArrays", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Thread", "/@", "mat"}], "]"}], ",", "vars"}], "]"}]}], 
     "}"}], ",", 
    RowBox[{"Normal", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"temp", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
        RowBox[{"-", 
         RowBox[{"{", 
          RowBox[{"temp", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "}"}]}]}], "]"}], "]"}], "]"}]}], 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
