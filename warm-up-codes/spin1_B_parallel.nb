Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "sigd", ",", "B", ",", "\[Beta]intra", ",", "\[Beta]inter", ",", 
     "\[Gamma]", ",", "vomm1", ",", "vomm2", ",", "vdotk1", ",", "vdotk2", 
     ",", "vvec", ",", "kf1", ",", "mvec1"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sigd", "[", 
    RowBox[{"B_", ",", "\[Beta]intra_", ",", "\[Beta]inter_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e", "=", "1"}], ",", 
       RowBox[{"\[Mu]", "=", "0.1"}], ",", 
       RowBox[{"\[CapitalDelta]", "=", "0.01"}], ",", 
       RowBox[{"vf", "=", "0.005"}], ",", "vvec", ",", "\[CapitalOmega]vec1", 
       ",", "mvec1", ",", "\[CapitalOmega]vec2", ",", "mvec2", ",", 
       "\[Theta]", ",", "\[Phi]", ",", "kf1", ",", "kf2", ",", "\[Theta]p", 
       ",", "chi", ",", "Dphase1", ",", "Dphase2", ",", "vomm1", ",", "vomm2",
        ",", "vdotk1", ",", "vdotk2", ",", "f1", ",", "f2", ",", "\[Tau]1", 
       ",", "\[Tau]2", ",", "h1", ",", "h2", ",", "zero1", ",", "zero2", ",", 
       "ct41", ",", "ct42", ",", "st41", ",", "st42", ",", "ct4ct41", ",", 
       "ct4ct42", ",", "st4st41", ",", "st4st42", ",", "ct4st41", ",", 
       "ct4st42", ",", "st21", ",", "st22", ",", "st4st21", ",", "st4st22", 
       ",", "ct4st21", ",", "ct4st22", ",", "st2st21", ",", "st2st22", ",", 
       "hzero1", ",", "hzero2", ",", "hct41", ",", "hct42", ",", "hst41", ",",
        "hst42", ",", "hst21", ",", "hst22", ",", "colvec", ",", "mat", ",", 
       "sol", ",", "\[CapitalLambda]1", ",", "\[CapitalLambda]2", ",", "s1", 
       ",", "s2", ",", "\[Lambda]1", ",", "a1", ",", "b1", ",", "c1", ",", 
       "\[Lambda]2", ",", "a2", ",", "b2", ",", "c2", ",", "int1", ",", 
       "int2", ",", "conteq", ",", "matr", ",", "totmat"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"chi", "=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"kf1", "[", "\[Theta]_", "]"}], "=", 
       FractionBox[
        RowBox[{"\[Mu]", "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["\[Mu]", "2"], "-", 
           RowBox[{"2", " ", "B", " ", "chi", " ", "e", " ", 
            SuperscriptBox["vf", "2"], " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}], 
        RowBox[{"2", " ", "vf"}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vvec", "[", "\[Theta]_", "]"}], "=", 
       RowBox[{
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}], "vf"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
