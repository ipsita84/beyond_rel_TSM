Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"vec1", ",", "vec1dag"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vec1", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "\[Phi]"}]], 
       SuperscriptBox[
        RowBox[{"cos", "[", 
         FractionBox["\[Theta]", "2"], "]"}], "2"]}], ",", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]], " ", 
        RowBox[{"sin", "[", "\[Theta]", "]"}]}], 
       SqrtBox["2"]], ",", 
      SuperscriptBox[
       RowBox[{"sin", "[", 
        FractionBox["\[Theta]", "2"], "]"}], "2"]}], "}"}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vec1dag", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Phi]"}]], 
       SuperscriptBox[
        RowBox[{"cos", "[", 
         FractionBox["\[Theta]", "2"], "]"}], "2"]}], ",", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]], " ", 
        RowBox[{"sin", "[", "\[Theta]", "]"}]}], 
       SqrtBox["2"]], ",", 
      SuperscriptBox[
       RowBox[{"sin", "[", 
        FractionBox["\[Theta]", "2"], "]"}], "2"]}], "}"}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Beta]intra", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"vec1dag", "[", 
           RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], ".", 
          RowBox[{"vec1", "[", 
           RowBox[{"\[Theta]p", ",", "\[Phi]p"}], "]"}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"vec1dag", "[", 
           RowBox[{"\[Theta]p", ",", "\[Phi]p"}], "]"}], ".", 
          RowBox[{"vec1", "[", 
           RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}], ")"}]}], 
       RowBox[{"2", "\[Pi]"}]], ",", 
      RowBox[{"{", 
       RowBox[{"\[Phi]p", ",", "0", ",", 
        RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], ",", "ass"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[Beta]inter", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"vec1dag", "[", 
           RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], ".", 
          RowBox[{"vec2", "[", 
           RowBox[{"\[Theta]p", ",", "\[Phi]p"}], "]"}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"vec2dag", "[", 
           RowBox[{"\[Theta]p", ",", "\[Phi]p"}], "]"}], ".", 
          RowBox[{"vec1", "[", 
           RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}], ")"}]}], 
       RowBox[{"2", "\[Pi]"}]], ",", 
      RowBox[{"{", 
       RowBox[{"\[Phi]p", ",", "0", ",", 
        RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], ",", "ass"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.955002506028242*^9, 3.955002570820467*^9}, {
  3.9550026030879374`*^9, 3.9550026363145022`*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"20770d84-28ab-43ad-9d84-f31f0bcd94d0"],

Cell[BoxData[
 RowBox[{"\[Beta]intra", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"cos", "[", 
       FractionBox["\[Theta]", "2"], "]"}], "4"], " ", 
     SuperscriptBox[
      RowBox[{"cos", "[", 
       FractionBox["\[Theta]p", "2"], "]"}], "4"]}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"sin", "[", 
       FractionBox["\[Theta]", "2"], "]"}], "4"], " ", 
     SuperscriptBox[
      RowBox[{"sin", "[", 
       FractionBox["\[Theta]p", "2"], "]"}], "4"]}], "+", 
