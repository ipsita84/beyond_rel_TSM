Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "en", "]"}], ";", 
  RowBox[{"c1", "=", "0.1"}], ";", 
  RowBox[{"v", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"en", "[", "k_", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c1", " ", "v", " ", 
      SuperscriptBox["k", "2"]}], ",", 
     RowBox[{"k", " ", "v", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c1", " ", "k", " ", "0.01"}], " ", "-", "1"}], ")"}]}], ",", 
     
     RowBox[{"k", " ", "v", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c1", " ", "k"}], " ", "+", "1"}], ")"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"op", "=", "0.75"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fac", "=", "0.15"}], ";", 
