Cell[BoxData[{
 RowBox[{
  RowBox[{"$PrePrint", "=", 
   RowBox[{
    RowBox[{"#", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Csc", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Sec", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}]}]}]}], "}"}]}], "&"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"repl", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kx", "->", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"ky", "->", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"kz", "->", 
      RowBox[{"k", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ass", "=", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "kx", ",", "ky", ",", "kz", ",", "k", ",", "\[Theta]", ",", "\[Chi]", ",",
         "\[Phi]", ",", "\[Theta]p", ",", "\[Phi]p", ",", "kp", ",", "vter", ",",
         "vter", ",", "cq", ",", "vf", ",", "B", ",", "\[Mu]", ",", "chi", ",",
         "fac"}], "}"}], " ", "\[Element]", " ", "Reals"}], " ", "&&", " ", 
     RowBox[{"k", ">", "0"}], " ", "&&", " ", 
     RowBox[{"kp", ">", "0"}], " ", "&&", " ", 
     RowBox[{"0", "<=", "\[Theta]", "<=", "\[Pi]"}], " ", "&&", " ", 
     RowBox[{"0", "<=", "\[Theta]p", "<=", "\[Pi]"}], " ", "&&", " ", 
