                   SuperscriptBox["e", "2"], " ", 
                   SuperscriptBox["vf", "3"], " ", 
                   SuperscriptBox[
                    RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]]}]}], 
              ")"}], 
             RowBox[{"2", "/", "3"}]]]}], ")"}]}], 
        SuperscriptBox["6", 
         RowBox[{"2", "/", "3"}]]], "/.", "rep"}]}], "}"}], ",", 
