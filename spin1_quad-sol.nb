Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"root0", ",", "rep"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Mu]", "->", "0.1"}], ",", 
     RowBox[{"vf", "->", "0.0001"}], ",", 
     RowBox[{"cq", "->", "0.1"}], ",", 
     RowBox[{"\[Theta]", "->", "\[Theta]"}], ",", 
     RowBox[{"B", "->", "10"}], ",", 
     RowBox[{"chi", "->", "1"}], ",", 
     RowBox[{"e", "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"root0", "[", "\[Theta]_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      SuperscriptBox["6", 
       RowBox[{"2", "/", "3"}]]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "9"}], " ", "B", " ", "chi", " ", 
         SuperscriptBox["cq", "2"], " ", "e", " ", 
         SuperscriptBox["vf", "3"], " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
        RowBox[{
         SqrtBox["3"], " ", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["cq", "3"], " ", 
           SuperscriptBox["vf", "3"]}]], " ", 
         SqrtBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "4"}], " ", 
            SuperscriptBox["\[Mu]", "3"]}], "+", 
           RowBox[{"27", " ", 
            SuperscriptBox["B", "2"], " ", "cq", " ", 
            SuperscriptBox["e", "2"], " ", 
            SuperscriptBox["vf", "3"], " ", 
            SuperscriptBox[
             RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]]}]}], ")"}], 
      RowBox[{"1", "/", "3"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SuperscriptBox["2", 
         RowBox[{"1", "/", "3"}]], 
        RowBox[{"cq", " ", "vf"}]], "+", 
       FractionBox[
        RowBox[{"2", " ", 
         SuperscriptBox["3", 
          RowBox[{"1", "/", "3"}]], " ", "\[Mu]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "9"}], " ", "B", " ", "chi", " ", 
            SuperscriptBox["cq", "2"], " ", "e", " ", 
            SuperscriptBox["vf", "3"], " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
           RowBox[{
            SqrtBox["3"], " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["cq", "3"], " ", 
              SuperscriptBox["vf", "3"]}]], " ", 
            SqrtBox[
             RowBox[{
              RowBox[{
               RowBox[{"-", "4"}], " ", 
               SuperscriptBox["\[Mu]", "3"]}], "+", 
              RowBox[{"27", " ", 
               SuperscriptBox["B", "2"], " ", "cq", " ", 
               SuperscriptBox["e", "2"], " ", 
               SuperscriptBox["vf", "3"], " ", 
               SuperscriptBox[
