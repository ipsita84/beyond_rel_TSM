Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "kfs", ",", "sig", ",", "B", ",", "tra11", ",", "\[Beta]00", ",", "ter11",
      ",", "\[Beta]10", ",", "vomm1", ",", "vomm2", ",", "vdotk1", ",", 
     "vdotk2", ",", "kf1", ",", "kf2", ",", "h10", ",", "h20", ",", "h11", 
     ",", "h21"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kfs", "[", 
    RowBox[{"B_", ",", "\[Theta]_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kf", ",", 
       RowBox[{"e", "=", "1"}], ",", 
       RowBox[{"\[Mu]", "=", "0.1"}], ",", 
       RowBox[{"vf", "=", "0.005"}], ",", 
       RowBox[{"cq", "=", "0.1"}], ",", "kf11", ",", "kf21", ",", "kf10", ",",
        "kf20"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"**", "**", "**"}], "*", " ", "first", " ", 
       RowBox[{"node", " ", "**", "**", "**", "**", "**"}]}], "*****)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"**", "**", "**", " ", "linear"}], " ", "band"}], " ", 
      "****)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"kf11", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Sort", "[", 
          RowBox[{"NSolveValues", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"vf", " ", "kf", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"2", " ", "cq", " ", "kf"}]}], ")"}]}], " ", "+", 
               FractionBox[
                RowBox[{"B", " ", "e", " ", "vf", "  ", 
                 RowBox[{"Cos", "[", "\[Theta]", "]"}]}], 
                RowBox[{"2", " ", "kf"}]]}], "==", "\[Mu]"}], " ", "&&", " ", 
             
             RowBox[{"kf", ">=", "0"}]}], ",", "kf", ",", "Reals"}], "]"}], 
          "]"}], ")"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"**", "**", " ", "flat"}], " ", "band"}], " ", "*****)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"kf10", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Sort", "[", 
          RowBox[{"NSolveValues", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"2", "cq", " ", "vf", " ", 
                SuperscriptBox["kf", "2"]}], "+", 
               FractionBox[
                RowBox[{"B", "   ", "e", " ", "vf", " ", 
                 RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "kf"]}], "==", 
              "\[Mu]"}], "  ", "&&", " ", 
             RowBox[{"kf", ">=", "0"}]}], ",", "kf", ",", "Reals"}], "]"}], 
          "]"}], ")"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
         "**", "**", "**", "**", "**", "**", "**", "**", "**", "**"}], 
       "*****)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"**", "**", "**"}], "*", " ", "second", " ", 
        RowBox[{"node", " ", "**", "**", "**", "**", "**"}]}], "*****)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"kf21", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Sort", "[", 
          RowBox[{"NSolveValues", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"vf", " ", "kf", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"2", " ", "cq", " ", "kf"}]}], ")"}]}], " ", "-", 
               FractionBox[
                RowBox[{"B", " ", "e", " ", "vf", " ", 
                 RowBox[{"Cos", "[", "\[Theta]", "]"}]}], 
                RowBox[{"2", " ", "kf"}]]}], "==", "\[Mu]"}], " ", "&&", " ", 
             
             RowBox[{"kf", ">=", "0"}]}], ",", "kf", ",", "Reals"}], "]"}], 
          "]"}], ")"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
