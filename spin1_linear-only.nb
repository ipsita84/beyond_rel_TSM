Cell[BoxData[
 RowBox[{
  RowBox[{"rep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Mu]", "->", "0.1"}], ",", 
     RowBox[{"cq", "->", "0.01"}], ",", 
     RowBox[{"vf", "->", "0.005"}], ",", 
     RowBox[{"\[Theta]", "->", "0"}], ",", 
     RowBox[{"chi", "->", "1"}], ",", 
     RowBox[{"e", "->", "1"}]}], "}"}]}], ";", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"\[Mu]", "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["\[Mu]", "2"], "-", 
           RowBox[{"2", "chi", "  ", "B", "  ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
            SuperscriptBox["vf", "2"]}]}]]}], 
        RowBox[{"2", " ", "vf"}]], "/.", "rep"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"\[Mu]", "+", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["\[Mu]", "2"], "-", 
              RowBox[{"2", " ", "vhi", " ", "B", "  ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
               SuperscriptBox["vf", "2"]}]}]]}], 
           RowBox[{"2", " ", "vf"}]], "-", 
          FractionBox[
           RowBox[{
            SuperscriptBox["\[Mu]", "2"], " ", "cq"}], 
           SuperscriptBox["vf", "2"]]}], "/.", "rep"}], ","}], "*)"}], 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{"6", " ", "cq"}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
