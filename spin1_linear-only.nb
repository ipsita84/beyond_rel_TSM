Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "sig", ",", "B", ",", "tra11", ",", "\[Beta]00", ",", "ter11", ",", 
     "\[Beta]10", ",", "vomm1", ",", "vomm2", ",", "vdotk1", ",", "vdotk2", ",",
      "kf1", ",", "kf2", ",", "h10", ",", "h20", ",", "h11", ",", "h21"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sig", "[", 
    RowBox[{
    "B_", ",", "\[Mu]_", ",", "vf_", ",", "cq_", ",", "tra11_", ",", 
     "ter11_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e", "=", "1"}], ",", "vvec11", ",", "vvec21", ",", "\[Theta]",
        ",", 
       RowBox[{"\[Phi]", "=", "0"}], ",", "\[Theta]p", ",", "chi", ",", 
       "Dphase1", ",", "Dphase2", ",", "vomm11", ",", "vomm21", ",", 
       "vdotk11", ",", "vdotk21", ",", "colvec", ",", "mat", ",", "sol", ",", 
       "\[CapitalLambda]11", ",", "\[CapitalLambda]21", ",", "a11", ",", 
       "b11", ",", "c11", ",", "a21", ",", "b21", ",", "c21", ",", "conteq", ",",
        "matr", ",", "totmat", ",", "kf11", ",", "kf21", ",", "h11", ",", 
       "h21", ",", "\[Tau]11", ",", "\[Tau]21", ",", "f11", ",", "f21", ",", 
       "ct411", ",", "st411", ",", "ct4ct411", ",", "st4st411", ",", 
       "ct4st411", ",", "ct4st211", ",", "st211", ",", "st4st211", ",", 
       "st2st211", ",", "ct421", ",", "st421", ",", "ct4ct421", ",", 
       "st4st421", ",", "ct4st221", ",", "st221", ",", "st4st221", ",", 
       "st2st221", ",", "ct4st421", ",", "hct411", ",", " ", "hct421", ",", 
       "hst411", ",", "hst421", ",", "hst211", ",", "hst221", ",", "zero11", ",",
        "zero21", ",", "hzero21", ",", "hzero11", ",", "conteq1", ",", 
       "int11", ",", "int21", ",", "s11", ",", "s21"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"chi", "=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"**", "**", "**"}], "*", " ", "first", " ", 
        RowBox[{"node", " ", "**", "**", "**", "**", "**"}]}], "*****)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"kf11", "[", "\[Theta]_", "]"}], "=", 
       RowBox[{
        RowBox[{"ifun", "[", 
         RowBox[{"\[Mu]", ",", "vf", ",", "cq", ",", "B", ",", "chi"}], "]"}],
         "[", "\[Theta]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vvec11", "[", "\[Theta]_", "]"}], "=", 
       RowBox[{"vf", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", "cq", " ", 
           RowBox[{"kf11", "[", "\[Theta]", "]"}]}]}], ")"}], 
        RowBox[{"{", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vomm11", "[", "\[Theta]_", "]"}], "=", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"-", "e"}], " ", "B", " ", "vf"}], 
         RowBox[{"2", 
          SuperscriptBox[
           RowBox[{"kf11", "[", "\[Theta]", "]"}], "2"]}]], 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"2", "\[Theta]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"2", "\[Theta]"}], "]"}], " ", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "\[Theta]"}], "]"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Dphase1", "[", "\[Theta]_", "]"}], "=", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"B", " ", "e", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], 
         SuperscriptBox[
          RowBox[{"kf11", "[", "\[Theta]", "]"}], "2"]]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vdotk11", "[", "\[Theta]_", "]"}], "=", 
       RowBox[{
        RowBox[{"vf", " ", 
         RowBox[{"kf11", "[", "\[Theta]", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "cq", " ", 
            RowBox[{"kf11", "[", "\[Theta]", "]"}]}]}], ")"}]}], "-", 
        FractionBox[
         RowBox[{"B", " ", "e", " ", "vf", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], 
         RowBox[{"2", " ", 
