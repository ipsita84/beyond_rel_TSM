            SuperscriptBox["vf", "3"], " ", 
            SuperscriptBox[
             RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]]}]}], ")"}], 
      RowBox[{"1", "/", "3"}]], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SuperscriptBox["2", 
         RowBox[{"1", "/", "3"}]], 
        RowBox[{"cq", " ", "vf"}]], "+", 
       FractionBox[
        RowBox[{"2", " ", 
         SuperscriptBox["3", 
          RowBox[{"1", "/", "3"}]], " ", "\[Mu]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "9"}], " ", "B", " ", "chi", " ", 
            SuperscriptBox["cq", "2"], " ", "e", " ", 
            SuperscriptBox["vf", "3"], " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
           RowBox[{
            SqrtBox["3"], " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["cq", "3"], " ", 
              SuperscriptBox["vf", "3"]}]], " ", 
            SqrtBox[
             RowBox[{
              RowBox[{
               RowBox[{"-", "4"}], " ", 
               SuperscriptBox["\[Mu]", "3"]}], "+", 
              RowBox[{"27", " ", 
