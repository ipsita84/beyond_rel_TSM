               SuperscriptBox["e", "2"], " ", 
               SuperscriptBox["vf", "3"], " ", 
               SuperscriptBox[
                RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]]}]}], ")"}], 
         RowBox[{"2", "/", "3"}]]]}], ")"}]}], "/.", "rep"}]}], ";"}], "\[IndentingNewLine]", 
