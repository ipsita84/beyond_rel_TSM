  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "rep", ",", "ass", ",", "\[CapitalOmega]vec", ",", "mvec", ",", "vomm"}],
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rep", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kx", "->", 
        RowBox[{"k", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", 
       RowBox[{"ky", "->", 
        RowBox[{"k", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
       RowBox[{"kz", "->", 
        RowBox[{"k", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ass", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", "vf", ",", "cq"}], "}"}], "\[Element]", "Reals"}], 
      " ", "&&", " ", 
      RowBox[{"k", ">", "0"}], " ", "&&", " ", 
      RowBox[{"vf", ">", "0"}], " ", "&&", " ", 
      RowBox[{"cq", ">", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalOmega]vec", "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["\[Chi]", 
        SuperscriptBox["k", "3"]]}], 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"kx", ",", "ky", ",", "kz"}], "}"}], "/.", "rep"}], ",", 
        RowBox[{"Assumptions", "->", "ass"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mvec", "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[Chi]", " ", "e", " ", "vf"}], 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["kx", "2"], "+", 
           SuperscriptBox["ky", "2"], "+", 
           SuperscriptBox["kz", "2"]}], ")"}]}]]}], " ", 
      RowBox[{"{", 
       RowBox[{"kx", ",", "ky", ",", "kz"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<e B . \[CapitalOmega]: \>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"e", " ", 
     RowBox[{"\[CapitalOmega]vec", ".", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "B"}], "}"}]}]}], "/.", "rep"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<OMM en:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "  ", 
    RowBox[{"enomm", " ", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"B", " ", ".", " ", "m"}]}], " ", "="}]}], " ", "*)"}], 
   RowBox[{"enomm", "=", 
    RowBox[{"-", 
     RowBox[{"mvec", ".", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "B"}], "}"}]}]}]}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Print", "[", "\"\<OMM vel:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"vomm", "=", 
    RowBox[{
     RowBox[{"Grad", "[", 
      RowBox[{"enomm", ",", 
       RowBox[{"{", 
        RowBox[{"kx", ",", "ky", ",", "kz"}], "}"}]}], "]"}], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{"vomm", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"vomm", "/.", "rep"}], ",", 
      RowBox[{"Assumptions", "->", "ass"}]}], "]"}]}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Print", "[", "\"\<vomm . \[CapitalOmega]: \>\"", "]"}], ";", 
    RowBox[{
     RowBox[{
      RowBox[{"vomm", ".", "\[CapitalOmega]vec"}], "/.", "rep"}], "//", 
     "FullSimplify"}]}]}]}]], "Input",
