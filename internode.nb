Notebook[{

Cell[CellGroupData[{
Cell["s=1 band", "Section",
 CellChangeTimes->{{3.957270904798074*^9, 
  3.957270906478437*^9}},ExpressionUUID->"5bd472f6-c956-481e-bc1b-\
37af2bfefe4d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"\[Chi]", "=", "1"}], ",", " ", 
    RowBox[{"linear", " ", "band", " ", "for", " ", "spin", " ", "1", " ", 
     RowBox[{"quadr", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "Be", ",", "det1", ",", "B", ",", "kx", ",", "ky", ",", "kz", ",", "k", ",",
       "s", ",", "v01", ",", " ", "\[CapitalOmega]1", ",", " ", "m1", ",", 
      "\[Eta]1", ",", " ", "\[Chi]", ",", "sig1at1"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rep", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kx", "->", 
        RowBox[{"k", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", 
       RowBox[{"ky", "->", 
        RowBox[{"k", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
       RowBox[{"kz", "->", 
        RowBox[{"k", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ass", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"EF", ",", " ", "s", ",", " ", "k", ",", "vf", ",", "cq"}], 
        "}"}], "\[Element]", " ", "Reals"}], " ", "&&", " ", 
      RowBox[{"EF", ">", "0"}], " ", "&&", "   ", 
      RowBox[{"EF", ">", "0"}], " ", "&&", " ", 
      RowBox[{"v0t", ">", "0"}], " ", "&&", " ", 
      RowBox[{"k", ">", "0"}], " ", "&&", " ", 
      RowBox[{"vf", ">", "0"}], " ", "&&", " ", 
      RowBox[{"cq", ">", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Be", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "B"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Chi]", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"det1", "=", 
     FractionBox[
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       SuperscriptBox["k", "2"]}], 
      RowBox[{
       SqrtBox["vf"], " ", 
       SqrtBox[
        RowBox[{"vf", "+", 
         RowBox[{"4", " ", "cq", " ", "\[Epsilon]"}]}]]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v01", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", "cq", " ", "k"}]}], ")"}], " ", "vf", 
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalOmega]1", "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["\[Chi]", 
        SuperscriptBox["k", "2"]]}], 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m1", "=", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"-", " ", "e"}], " ", "vf", " ", "\[Chi]"}], 
       RowBox[{"2", " ", 
        SuperscriptBox["k", "2"]}]], 
      RowBox[{"{", 
       RowBox[{"kx", ",", "ky", ",", "kz"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Eta]1", "=", 
     RowBox[{"-", 
      RowBox[{"m1", ".", "Be"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u1", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Grad", "[", 
         RowBox[{"\[Eta]1", ",", 
          RowBox[{"{", 
           RowBox[{"kx", ",", "ky", ",", "kz"}], "}"}]}], "]"}], "/.", 
        "rep"}], ",", 
       RowBox[{"Assumptions", "->", "ass"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
