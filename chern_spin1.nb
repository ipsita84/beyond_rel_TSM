    RowBox[{"derz", "=", 
     RowBox[{"D", "[", 
      RowBox[{"ham", ",", "kz"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vecdag", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "vec", "]"}], ",", " ", 
       RowBox[{"Assumptions", "->", "ass"}]}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"en", "/.", 
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["kz", "2"], "->", 
          RowBox[{
           SuperscriptBox["k", "2"], "-", 
