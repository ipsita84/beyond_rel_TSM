Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"**", "**", "fix"}], " ", "\[Chi]", " ", 
     RowBox[{"value", ":", " ", "\[Chi]"}]}], "=", "1"}], " ", "*******)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "\[Chi]", ",", "ham", ",", "en", ",", " ", "vec", ",", " ", "v1", ",", 
      "v2", ",", "v3", ",", " ", "v1c", ",", " ", "v2c", ",", "v3c", ",", " ",
       "\[Psi]1", ",", " ", "\[Psi]1dag", ",", " ", "\[Psi]2dag", ",", " ", 
      "\[Psi]2", ",", "\[Psi]3", ",", " ", "\[Psi]3dag", ",", "vecdag", ",", 
      " ", "derx", ",", "dery"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ham", "=", 
     RowBox[{"hamil", "[", "1", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"ham", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"en", ",", "vec"}], "}"}], "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Eigensystem", "[", "ham", "]"}], ",", 
       RowBox[{"Assumptions", "\[Rule]", "ass"}]}], "]"}]}], ";", 
    RowBox[{"derx", "=", 
     RowBox[{"D", "[", 
      RowBox[{"ham", ",", "kx"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dery", "=", 
